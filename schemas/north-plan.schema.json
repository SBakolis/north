{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://north.dev/schemas/north-plan.schema.json",
  "title": "North Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "north/v1alpha1" },
    "kind": { "const": "ExecutionPlan" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "baseRef", "stages"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "baseRef": { "type": "string", "minLength": 1 },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxParallel": { "type": "integer", "minimum": 1, "maximum": 64, "default": 1 },
            "failFast": { "type": "boolean", "default": true },
            "maxAttemptsPerStage": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
            "finalVerificationRequired": { "type": "boolean", "default": true },
            "autoResolveConflicts": { "type": "boolean", "default": false }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 63, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "safePath": { "type": "string", "minLength": 1, "not": { "pattern": "(?:^[/\\\\]|^[A-Za-z]:[/\\\\]|(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))" } },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["command", "exec", "shell", "file-exists", "file-not-exists", "contains", "matches", "git-diff-not-empty"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "path": { "$ref": "#/$defs/safePath" },
        "value": { "type": "string" },
        "timeout": { "type": "string", "pattern": "^[0-9]+(?:ns|us|µs|ms|s|m|h)(?:[0-9]+(?:ns|us|µs|ms|s|m|h))*$" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["command", "exec"] } } }, "then": { "required": ["command"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["value"] }] } } },
        { "if": { "properties": { "type": { "const": "shell" } } }, "then": { "required": ["command"], "properties": { "command": { "minItems": 1, "maxItems": 1 } }, "not": { "anyOf": [{ "required": ["path"] }, { "required": ["value"] }] } } },
        { "if": { "properties": { "type": { "enum": ["file-exists", "file-not-exists"] } } }, "then": { "required": ["path"], "not": { "anyOf": [{ "required": ["command"] }, { "required": ["value"] }] } } },
        { "if": { "properties": { "type": { "enum": ["contains", "matches"] } } }, "then": { "required": ["path", "value"], "not": { "required": ["command"] } } },
        { "if": { "properties": { "type": { "const": "git-diff-not-empty" } } }, "then": { "not": { "anyOf": [{ "required": ["command"] }, { "required": ["path"] }] } } }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "default": [] },
        "agent": { "type": "string", "minLength": 1 },
        "writeScope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" }, "default": [] },
        "acceptance": { "type": "array", "items": { "$ref": "#/$defs/acceptance" }, "default": [] },
        "allowNoChanges": { "type": "boolean", "default": false }
      }
    }
  }
}
